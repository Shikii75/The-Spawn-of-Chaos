/* =============================================================================
   THE SPAWN OF CHAOS - HIGH-AESTHETIC MAIN MENU STYLESHEET (USS)
   Deep Grey Void Canvas + 120-Frame Logo Animation + Procedural Cyber-Gothic Buttons
   ============================================================================= */

/* ── Fullscreen Root Container ── */
.menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: #030006;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}


/* Central Cosmic Nebula Glow (Matches Tutorial Prologue Ambiance) */
.cosmic-nebula-glow {
    position: absolute;
    left: 15%;
    top: 15%;
    right: 15%;
    bottom: 15%;
    width: 70%;
    height: 70%;
    background-color: rgba(76, 18, 120, 0.22);
    border-radius: 50%;
}

/* Completely Solid Deep Cosmic Void Background Layer */
.menu-background-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: #030006;
    opacity: 1.0;
}

/* ── Living Void Floating Purple Orbs Overlay Layer ── */
.orbs-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.menu-firefly {
    position: absolute;
    background-color: transparent;
}

/* ── Corner Framing Brackets ── */
.corner-bracket {
    position: absolute;
    width: 36px;
    height: 36px;
    border-color: rgba(180, 185, 200, 0.4);
}

.corner--tl {
    left: 36px;
    top: 32px;
    border-left-width: 2px;
    border-top-width: 2px;
}

.corner--tr {
    right: 36px;
    top: 32px;
    border-right-width: 2px;
    border-top-width: 2px;
}

.corner--bl {
    left: 36px;
    bottom: 32px;
    border-left-width: 2px;
    border-bottom-width: 2px;
}

.corner--br {
    right: 36px;
    bottom: 32px;
    border-right-width: 2px;
    border-bottom-width: 2px;
}

/* ── Main Layout (Center Column: Logo above + Buttons below) ── */
.main-layout-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding-top: 2%;
    padding-bottom: 3%;
    padding-left: 2%;
    padding-right: 2%;
    overflow: visible;
}

/* ── Centerpiece Logo Artwork Area ── */
.title-logo-container {
    cursor: link;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
    overflow: visible;
}

.title-logo-image {
    cursor: link;
    width: 680px;
    height: 382px;
    max-width: 72%;
    max-height: 48%;
    background-image: url('project://database/Assets/Scenes/animations/frames/keep-54947fd1/frame_001.png');
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 1;
    transition-property: scale;
    transition-duration: 0.15s;
}

.title-logo-image:hover {
    scale: 1.02 1.02;
}

.title-logo-image:active {
    scale: 0.98 0.98;
}

/* ── Horizontal Navigation Row (Positioned higher) ── */
.nav-section {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: -6px;
    margin-bottom: 24px;
}

/* ── Procedural Cyber-Gothic Glassmorphic Buttons ── */
.cyber-button {
    width: 200px;
    max-width: 18%;
    height: 68px;
    margin-left: 8px;
    margin-right: 8px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(18, 19, 26, 0.96);
    border-color: rgba(168, 85, 247, 0.5);
    border-width: 1px;
    border-radius: 6px 18px 6px 18px;
    justify-content: space-between;
    align-items: stretch;
    overflow: hidden;
    flex-shrink: 1;
    transition-property: all;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.btn-top-accent {
    height: 3px;
    width: 100%;
    background-color: rgba(168, 85, 247, 0.35);
    transition-property: background-color;
    transition-duration: 0.22s;
}

.btn-bottom-accent {
    height: 2px;
    width: 100%;
    background-color: transparent;
    transition-property: background-color;
    transition-duration: 0.22s;
}

.btn-content-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-grow: 1;
    padding-left: 4px;
    padding-right: 4px;
}

.btn-copy {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.btn-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: #f1f5f9;
    letter-spacing: 4px;
    transition-property: color;
    transition-duration: 0.22s;
}

.btn-hint {
    margin-top: 3px;
    font-size: 9px;
    color: rgba(226, 232, 240, 0.55);
    letter-spacing: 2px;
}

.btn-rune {
    width: 28px;
    height: 28px;
    font-size: 13px;
    color: #c084fc;
    opacity: 0.65;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(192, 132, 252, 0.4);
    background-color: rgba(168, 85, 247, 0.1);
    -unity-text-align: middle-center;
    transition-property: opacity, translate, color;
    transition-duration: 0.22s;
}

.cyber-button--continue {
    background-color: rgba(26, 16, 42, 0.95);
    border-color: rgba(168, 85, 247, 0.65);
}

.cyber-button--continue .btn-top-accent,
.cyber-button--continue .btn-rune {
    background-color: rgba(168, 85, 247, 0.28);
    color: #d8b4fe;
    border-color: rgba(192, 132, 252, 0.55);
}

/* Primary Action: New Game (Electric Violet / Radiant Purple) */
.cyber-button--play {
    background-color: rgba(30, 16, 52, 0.96);
    border-color: rgba(192, 132, 252, 0.75);
}

.cyber-button--play .btn-top-accent,
.cyber-button--play .btn-rune {
    background-color: rgba(192, 132, 252, 0.35);
    color: #f3e8ff;
    border-color: rgba(233, 213, 255, 0.65);
}

/* Secondary Action: Load Game (Ethereal Orchid / Celestial Magenta-Purple) */
.cyber-button--load {
    background-color: rgba(28, 14, 46, 0.95);
    border-color: rgba(217, 70, 239, 0.65);
}

.cyber-button--load .btn-top-accent,
.cyber-button--load .btn-rune {
    background-color: rgba(217, 70, 239, 0.28);
    color: #f5d0fe;
    border-color: rgba(240, 171, 252, 0.55);
}

/* Options / Settings (Mystic Violet) */
.cyber-button--options {
    background-color: rgba(22, 14, 38, 0.95);
    border-color: rgba(147, 51, 234, 0.65);
}

.cyber-button--options .btn-top-accent,
.cyber-button--options .btn-rune {
    background-color: rgba(147, 51, 234, 0.25);
    color: #c084fc;
    border-color: rgba(168, 85, 247, 0.5);
}

/* Quit Button (Dusky Void Plum) */
.cyber-button--quit {
    background-color: rgba(20, 10, 32, 0.95);
    border-color: rgba(126, 34, 206, 0.55);
}

.cyber-button--quit .btn-top-accent,
.cyber-button--quit .btn-rune {
    background-color: rgba(126, 34, 206, 0.22);
    color: #d8b4fe;
    border-color: rgba(147, 51, 234, 0.45);
}

/* Hover States (Harmonious Shades of Purple Glow) */
.cyber-button:hover {
    scale: 1.04 1.04;
    translate: 0px -4px;
    background-color: rgba(46, 20, 78, 0.98);
    border-color: #e9d5ff;
    border-width: 1px;
}

.cyber-button:hover .btn-top-accent {
    background-color: #c084fc;
}

.cyber-button:hover .btn-bottom-accent {
    background-color: rgba(168, 85, 247, 0.45);
}

.cyber-button:hover .btn-label {
    color: #ffffff;
    text-shadow: 0 0 12px rgba(233, 213, 255, 0.95);
}

.cyber-button:hover .btn-rune {
    color: #f3e8ff;
    border-color: #e9d5ff;
    background-color: rgba(192, 132, 252, 0.35);
    opacity: 1.0;
}

.cyber-button:hover .btn-rune--left {
    translate: -3px 0px;
}

.cyber-button:hover .btn-rune--right {
    translate: 3px 0px;
}

/* Active Press States */
.cyber-button:active {
    scale: 0.97 0.97;
    translate: 0px -2px;
    background-color: rgba(88, 28, 135, 0.65);
    border-color: #d8b4fe;
}

.cyber-button:focus {
    border-color: #ffffff;
}

/* ── Modals (Settings & Options) ── */
.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 2, 10, 0.92);
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.modal-card {
    width: 580px;
    max-height: 85%;
    background-color: rgba(22, 20, 30, 0.98);
    border-color: #a855f7;
    border-width: 1.5px;
    border-radius: 14px;
    padding: 30px;
}

.modal-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(168, 85, 247, 0.3);
    padding-bottom: 12px;
    margin-bottom: 22px;
}

.modal-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 3px;
}

.modal-close-btn {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: rgba(147, 51, 234, 0.25);
    border-color: rgba(192, 132, 252, 0.6);
    border-width: 1px;
    color: #e9d5ff;
    font-size: 16px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
}

.modal-close-btn:hover {
    background-color: rgba(147, 51, 234, 0.75);
    color: #ffffff;
}

.setting-row {
    margin-bottom: 18px;
}

.setting-label {
    font-size: 13px;
    color: #c4b5fd;
    -unity-font-style: bold;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.unity-slider .unity-base-slider__tracker {
    height: 6px;
    background-color: rgba(46, 16, 101, 0.9);
    border-radius: 3px;
    border-width: 0;
}

.unity-slider .unity-base-slider__dragger {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: #c084fc;
    border-color: #ffffff;
    border-width: 1px;
    margin-top: -6px;
}

.unity-slider .unity-base-slider__dragger:hover {
    background-color: #9333ea;
    scale: 1.2 1.2;
}

.setting-toggle {
    margin-top: 10px;
    font-size: 14px;
    color: #e2e8f0;
}

.setting-toggle .unity-toggle__checkmark {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background-color: rgba(46, 16, 101, 0.9);
    border-color: #a855f7;
    border-width: 1.5px;
}

.setting-toggle:checked .unity-toggle__checkmark {
    background-color: #9333ea;
    border-color: #e9d5ff;
}

/* Visibility classes */
.panel--hidden {
    display: none;
    opacity: 0;
}

.panel--visible {
    display: flex;
    opacity: 1;
}


/* ── 12-Slot Load Game Modal Styling ── */
.modal-card--load {
    width: 860px;
    max-height: 85%;
    padding: 24px;
}

.slots-scroll-view {
    width: 100%;
    max-height: 520px;
    padding-right: 12px;
}

.slots-grid-container {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.slot-card {
    width: 48%;
    background-color: rgba(30, 24, 44, 0.94);
    border-color: rgba(168, 85, 247, 0.5);
    border-width: 1px;
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 12px;
}

.slot-card:hover {
    border-color: #c084fc;
    background-color: rgba(45, 30, 70, 0.98);
}

.slot-card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.slot-badge {
    font-size: 11px;
    -unity-font-style: bold;
    color: #e9d5ff;
    background-color: rgba(168, 85, 247, 0.35);
    border-radius: 4px;
    padding: 2px 6px;
}

.slot-date {
    font-size: 10px;
    color: #a78bfa;
}

.slot-location {
    font-size: 14px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-bottom: 4px;
}

.slot-details-row {
    flex-direction: row;
    justify-content: space-between;
    font-size: 11px;
    color: #c4b5fd;
    margin-bottom: 8px;
}

.slot-actions-row {
    flex-direction: row;
    justify-content: flex-end;
}

.slot-btn {
    border-radius: 5px;
    padding: 4px 12px;
    font-size: 11px;
    -unity-font-style: bold;
}

.slot-btn--load {
    background-color: rgba(168, 85, 247, 0.6);
    border-color: #c084fc;
    color: #ffffff;
    margin-left: 8px;
}

.slot-btn--load:hover {
    background-color: #9333ea;
}

.slot-btn--del {
    background-color: rgba(225, 29, 72, 0.25);
    border-color: rgba(192, 132, 252, 0.6);
    color: #e9d5ff;
}

.slot-btn--del:hover {
    background-color: rgba(147, 51, 234, 0.75);
    color: #ffffff;
}

.slot-card--empty {
    opacity: 0.65;
    border-color: rgba(168, 85, 247, 0.3);
}

.slot-card--empty:hover {
    opacity: 1.0;
    border-color: #a855f7;
}


