<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="MainMenu.uss" />
    
    <!-- Fullscreen Root Container -->
    <ui:VisualElement name="menu-root" class="menu-root">
        
        <!-- Deep Grey Background Layer -->
        <ui:VisualElement name="bg-layer" class="menu-background-layer" picking-mode="Ignore" />

        <!-- Framing Corner Brackets -->
        <ui:VisualElement class="corner-bracket corner--tl" picking-mode="Ignore" />
        <ui:VisualElement class="corner-bracket corner--tr" picking-mode="Ignore" />
        <ui:VisualElement class="corner-bracket corner--bl" picking-mode="Ignore" />
        <ui:VisualElement class="corner-bracket corner--br" picking-mode="Ignore" />

        <!-- Gentle Fireflies Overlay Layer (Bottom to Top) -->
        <ui:VisualElement name="orbs-container" class="orbs-container" picking-mode="Ignore" />

        <!-- Main Screen Layout (Centerpiece Logo + Horizontal Button Row) -->
        <ui:VisualElement name="main-layout" class="main-layout-container">
            
            <!-- Centerpiece Logo Artwork with Frame Animation -->
            <ui:VisualElement name="title-container" class="title-logo-container">
                <ui:VisualElement name="title-logo" class="title-logo-image" />
            </ui:VisualElement>

            <!-- Navigation Row with Continue, New Game, Load Game (12 Slots), Options, Quit -->
            <ui:VisualElement name="nav-section" class="nav-section">
                
                <!-- Continue Button -->
                <ui:Button name="btn-continue" class="cyber-button cyber-button--continue">
                    <ui:VisualElement class="btn-top-accent" />
                    <ui:VisualElement class="btn-content-row">
                        <ui:Label text="✦" class="btn-rune btn-rune--left" />
                        <ui:VisualElement class="btn-copy">
                            <ui:Label text="CONTINUE" class="btn-label" />
                            <ui:Label text="RESUME SAGA" class="btn-hint" />
                        </ui:VisualElement>
                        <ui:Label text="✦" class="btn-rune btn-rune--right" />
                    </ui:VisualElement>
                    <ui:VisualElement class="btn-bottom-accent" />
                </ui:Button>

                <!-- New Game Button -->
                <ui:Button name="btn-new-game" class="cyber-button cyber-button--play">
                    <ui:VisualElement class="btn-top-accent" />
                    <ui:VisualElement class="btn-content-row">
                        <ui:Label text="⚔" class="btn-rune btn-rune--left" />
                        <ui:VisualElement class="btn-copy">
                            <ui:Label text="NEW GAME" class="btn-label" />
                            <ui:Label text="BEGIN DESCENT" class="btn-hint" />
                        </ui:VisualElement>
                        <ui:Label text="⚔" class="btn-rune btn-rune--right" />
                    </ui:VisualElement>
                    <ui:VisualElement class="btn-bottom-accent" />
                </ui:Button>

                <!-- Load Game (12 Slots) Button -->
                <ui:Button name="btn-load-game" class="cyber-button cyber-button--load">
                    <ui:VisualElement class="btn-top-accent" />
                    <ui:VisualElement class="btn-content-row">
                        <ui:Label text="❖" class="btn-rune btn-rune--left" />
                        <ui:VisualElement class="btn-copy">
                            <ui:Label text="LOAD GAME" class="btn-label" />
                            <ui:Label text="12 MEMORY SLOTS" class="btn-hint" />
                        </ui:VisualElement>
                        <ui:Label text="❖" class="btn-rune btn-rune--right" />
                    </ui:VisualElement>
                    <ui:VisualElement class="btn-bottom-accent" />
                </ui:Button>

                <!-- Options Button -->
                <ui:Button name="btn-settings" class="cyber-button cyber-button--options">
                    <ui:VisualElement class="btn-top-accent" />
                    <ui:VisualElement class="btn-content-row">
                        <ui:Label text="⚙" class="btn-rune btn-rune--left" />
                        <ui:VisualElement class="btn-copy">
                            <ui:Label text="OPTIONS" class="btn-label" />
                            <ui:Label text="TUNE YOUR RITUAL" class="btn-hint" />
                        </ui:VisualElement>
                        <ui:Label text="⚙" class="btn-rune btn-rune--right" />
                    </ui:VisualElement>
                    <ui:VisualElement class="btn-bottom-accent" />
                </ui:Button>

                <!-- Quit Button -->
                <ui:Button name="btn-quit" class="cyber-button cyber-button--quit">
                    <ui:VisualElement class="btn-top-accent" />
                    <ui:VisualElement class="btn-content-row">
                        <ui:Label text="✕" class="btn-rune btn-rune--left" />
                        <ui:VisualElement class="btn-copy">
                            <ui:Label text="QUIT" class="btn-label" />
                            <ui:Label text="LEAVE THE REALM" class="btn-hint" />
                        </ui:VisualElement>
                        <ui:Label text="✕" class="btn-rune btn-rune--right" />
                    </ui:VisualElement>
                    <ui:VisualElement class="btn-bottom-accent" />
                </ui:Button>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Settings Modal Dialog -->
        <ui:VisualElement name="modal-settings" class="modal-overlay panel--hidden">
            <ui:VisualElement class="modal-card">
                <ui:VisualElement class="modal-header">
                    <ui:Label text="REALM CONFIGURATION" class="modal-title" />
                    <ui:Button name="btn-close-settings" text="✕" class="modal-close-btn" />
                </ui:VisualElement>
                
                <ui:VisualElement class="modal-body">
                    <!-- Master Volume -->
                    <ui:VisualElement class="setting-row">
                        <ui:Label text="MASTER AUDIO VOLUME" class="setting-label" />
                        <ui:Slider name="slider-master" low-value="0" high-value="1" value="1" />
                    </ui:VisualElement>
                    
                    <!-- Music Volume -->
                    <ui:VisualElement class="setting-row">
                        <ui:Label text="MUSIC VOLUME" class="setting-label" />
                        <ui:Slider name="slider-music" low-value="0" high-value="1" value="0.8" />
                    </ui:VisualElement>

                    <!-- SFX Volume -->
                    <ui:VisualElement class="setting-row">
                        <ui:Label text="SFX VOLUME" class="setting-label" />
                        <ui:Slider name="slider-sfx" low-value="0" high-value="1" value="0.9" />
                    </ui:VisualElement>

                    <!-- Fullscreen Toggle -->
                    <ui:Toggle name="toggle-fullscreen" label="FULLSCREEN DISPLAY" value="true" class="setting-toggle" />
                    
                    <!-- Screen Shake Toggle -->
                    <ui:Toggle name="toggle-screenshake" label="CAMERA SHAKE" value="true" class="setting-toggle" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Load Game (12 Slots) Modal Dialog -->
        <ui:VisualElement name="modal-load-game" class="modal-overlay panel--hidden">
            <ui:VisualElement class="modal-card modal-card--load">
                <ui:VisualElement class="modal-header">
                    <ui:Label text="CHRONICLES OF DESTINY — 12 MEMORY SLOTS" class="modal-title" />
                    <ui:Button name="btn-close-load-game" text="✕" class="modal-close-btn" />
                </ui:VisualElement>
                
                <ui:ScrollView name="slots-scroll-view" class="slots-scroll-view">
                    <ui:VisualElement name="slots-grid" class="slots-grid-container">
                        <!-- Populated dynamically via MainMenuUIToolkitController -->
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
